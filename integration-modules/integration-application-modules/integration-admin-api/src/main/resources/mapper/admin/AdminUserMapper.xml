<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.integration.admin.rbac.mapper.AdminUserMapper">

    <select id="selectByUsername" resultType="com.integration.admin.rbac.entity.AdminUser">
        SELECT *
        FROM admin_user
        WHERE username = #{username}
        LIMIT 1
    </select>

</mapper>
