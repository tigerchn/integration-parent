    <description>HTTP APIs for mini-program and native mobile app clients</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.integration</groupId>
            <artifactId>integration-common-web-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.integration</groupId>
            <artifactId>integration-common-tracing-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.integration</groupId>
            <artifactId>integration-common-tool-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.integration</groupId>
            <artifactId>integration-common-knife4j-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.integration</groupId>
            <artifactId>integration-common-job-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.integration</groupId>
            <artifactId>integration-common-test-starter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
